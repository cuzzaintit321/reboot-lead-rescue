# Copy to .env and set strong secrets before deployment.
APP_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
BUSINESS_NAME=Reboot Syndicate Demo
DATABASE_URL=sqlite:////app/data/lead_rescue.sqlite3
PUBLIC_BASE_URL=http://localhost:8135
COOKIE_SECURE=false
# Only enable after A2P approval, consent controls and real provider setup.
SMS_MODE=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Set to true only when the webhook URL is public HTTPS and Twilio is configured.
REQUIRE_TWILIO_SIGNATURE=true
